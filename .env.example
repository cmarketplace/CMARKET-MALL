# 세모 큐레이션 피드 — 이 쇼핑몰의 상품 출처 (src/lib/semo-feed.ts)
#
# 세모 마스터가 「이 쇼핑몰 × 품목 × 공급사」로 승인한 조합만 내려온다.
# 셋 다 서버 전용이다 — NEXT_PUBLIC_ 을 붙이면 파트너 키가 브라우저 번들로 새 나간다.

# 세모 API 베이스. 운영 https://api.semo.io.kr/api/v1 · 로컬 http://localhost:5555/api/v1
SEMO_API_BASE=https://api.semo.io.kr/api/v1

# 세모 external API 파트너 키. 이 쇼핑몰 전용이 아니라 씨마켓 연동 전체가 쓰는 키다.
SEMO_API_KEY=

# 쇼핑몰 식별자. 세모 어드민의 storefronts.slug 와 같아야 한다.
#
# `c-point` 는 세모에 **이미 등록되어 있다**(2026-08-24 확인: items/categories 둘 다 200).
# 다만 승인된 품목이 아직 0건이라 목록은 「아직 등록된 상품이 없습니다」로 뜬다 —
# 장애가 아니라 세모 쪽에서 이 몰에 품목을 승인해 주면 그대로 채워진다.
# 화면을 데이터가 있는 상태로 보고 싶으면 잠깐 `kclmro` 로 바꿔 띄운다(커밋하지 않는다).
STOREFRONT_SLUG=c-point

# ── 씨마켓 SSO (OAuth 2.0 authorization_code + PKCE) ─────────────────────
#
# 이 몰의 유일한 인증 경로다. 씨마켓(c-market.kr)과 이 몰은 별도 등록 도메인이라 쿠키를
# 공유할 수 없다 — top-level 리다이렉트로 신원을 받아 이 도메인의 first-party 세션을
# 새로 발급한다. 아래 다섯 값이 **모두** 차 있어야 로그인이 열린다. 하나라도 비면
# 운영에서는 /shop 이 닫히고(로그인 화면이 사유를 밝힌다), 로컬에서는 게이트를 통과한다.

# 씨마켓 어드민이 발급한 **SSO 전용** 파트너 키. 서버 전용이다.
#
# 발급 조건 넷이 동시에 맞아야 로그인이 열린다. 하나라도 어긋나면 토큰 교환에서 죽고
# 화면에는 사유가 안 나온다(서버 로그의 `[auth] cause:` 를 봐야 한다).
#
#   1. 스코프가 `sso:login` **단독**. 씨마켓은 모든 파트너 키에 「허용 IP 또는 DPoP 중
#      최소 하나」를 요구하는데 SSO 전용 키만 그 불변식에서 면제된다. ERP 스코프를 얹으면
#      면제가 사라져 아래 2·3 을 강제당한다.
#   2. **허용 IP 는 비운다.** 이 몰은 Vercel 서버리스라 발신 IP 가 고정되지 않는다.
#      목록이 있으면 절대 일치하지 않아 영구 401(`invalid_client / client IP not allowed`).
#   3. **DPoP 는 끈다.** 씨마켓은 DPoP 로 묶인 키의 authorization_code 교환을 거절한다
#      (`unauthorized_client`) — SSO 토큰에 `cnf`(jkt)를 실을 자리가 없어서다.
#      KCL 몰이 2026-09-01 에 이걸로 하루를 날렸다.
#   4. 「전체 회원 허용」을 켠다. 씨마켓몰은 특정 기관 폐쇄몰이 아니다.
#
# 콜백 주소도 그 키에 **정확일치**로 등록되어야 한다(경로·쿼리까지):
#   https://<이 몰 도메인>/api/auth/callback/cmarket   (로컬: http://localhost:3001/...)
#
# 서버 간 호출(client_credentials)이 나중에 필요해지면 **다른 키로** 발급한다.
# 그쪽은 DPoP 를 켜는 것이 맞고, 한 벌로 겸할 수 없다.
CMARKET_CLIENT_ID=
CMARKET_CLIENT_SECRET=

# Auth.js 세션 서명 키. `openssl rand -base64 32` 로 만든다.
AUTH_SECRET=

# 배포 도메인. Auth.js 가 콜백 URL 을 만들 때 쓴다. 씨마켓에 등록한 redirect_uri 와
# 정확일치해야 한다. 로컬은 비워 둔다(Next 가 요청 호스트를 쓴다).
# 프리뷰 URL 을 등록하지 말 것 — 배포마다 바뀌어 다음 배포에서 콜백이 어긋난다.
AUTH_URL=

# authorize 진입점.
#
# 씨마켓몰은 **전체 개방 몰**이라 테넌트 호스트가 아니라 **본진**을 쓴다 — 전 회원 대상이라
# 기관 브랜딩도, host 기반 그룹 판정도 필요 없다. 폐쇄몰(KCL 등)만 `kcl.c-market.kr` 같은
# 테넌트 호스트를 쓴다. 기본값은 두지 않았다(남의 몰 화면이 뜬다).
#
#   운영    https://www.c-market.net/sso/authorize
#   로컬    http://localhost:5173/sso/authorize
CMARKET_AUTHORIZE_URL=

# 토큰 교환·신원 조회는 **파트너 API** 다. app-api.c-market.net 은 씨마켓 내부 전용이라
# 이 몰의 자격증명으로는 401 이고, api.c-market.net 은 V5 어댑터라 404 다. 평소엔 비워 둔다.
CMARKET_API_BASE=https://partner-api.c-market.net

# (선택) 이 몰이 **추가로** 좁히는 기관 그룹(씨마켓 b2b_member.group_code). 쉼표로 여러 개.
#
# 평소엔 비워 둔다. 입장 자격의 정본은 씨마켓 어드민(파트너 키 > SSO 클라이언트 > 허용 기관)이고,
# 몰이 같은 목록을 또 들고 있으면 기관을 추가할 때마다 두 곳을 고쳐야 한다 — 한쪽만 고치면
# 어긋난 채로 조용히 지나간다. 씨마켓 등록이 잘못 넓어져도 이 몰만은 막고 싶을 때만 채운다.
CMARKET_GROUP_CODES=

# ── 세모 연동 전 임시 스위치 ───────────────────────────────────────────
#
# 세모 키가 없으면 카탈로그는 예시 데이터(src/lib/catalog-stub.ts)로 돈다. 키가 있어도 승인
# 품목이 0건인 동안 화면을 채워 보려면 1 로 켠다. 운영 환경변수에는 넣지 않는다.
# SHOP_DEMO_CATALOG=1

# 주문 경로(안전결제/직접 구매)·결제수단·견적번호·오퍼 지정을 세모 주문 API 에 보낼지.
# 세모 DTO 가 이 필드를 받기 전에 켜면 whitelist 검증에서 400 이 나 주문이 막힌다.
# 세모가 받기 시작한 환경에서만 1 로 켠다(src/lib/semo-orders.ts).
# SEMO_ORDER_EXT=1

# 포인트몰 스텁과 같은 데모 신원 — SSO 파트너 키 발급 전에 주문 화면을 눌러 보는 용도.
# 운영 환경변수에는 절대 넣지 않는다. 실세션이 있으면 실세션이 이긴다.
# SHOP_DEMO_MEMBER=cpoint-demo
# SHOP_DEMO_MEMBER_NAME=데모 담당자
# 데모 신원의 역할. BUYER(기본)=발주기관 화면, SUPPLIER=공급사 고객 화면(판매가만 보임·안전결제만).
# SHOP_DEMO_ROLE=BUYER

# 링크로 바로 사기(2026-10-21) — URL 하나로 세모 물품 등록·판매 금액 자동 책정·장바구니 담기. 기본 꺼짐.
# 세모 URL 담기 엔진(세모 #1530)이 운영에 나가고, 세모 관리자에서 몰 «대신 사 드림» 판매자를 정한 뒤 켠다.
# SHOP_LINK_BUY=1
# 스텁(세모 키 없음)에서 «가격이 바뀌었어요» 화면을 보려면 다시 읽을 때 판매가를 이만큼 올린다(로컬 전용).
# SHOP_LINK_STUB_PRICE_BUMP=1100
